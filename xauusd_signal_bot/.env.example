# ---------------------------------------------------------------------------
# XAUUSD + BTCUSD M1 micro-scalping research system
# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
#
# This is a PAPER / RESEARCH system. It never places an order.
# ---------------------------------------------------------------------------

# --- MetaTrader 5 (market data only) ----------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if MT5 is not in the default location
MT5_TERMINAL_PATH=

# How many hours the broker's server clock is AHEAD of UTC.
# Most gold brokers run EET: 2 in winter, 3 in summer.
MT5_SERVER_UTC_OFFSET_HOURS=0

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather; chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_CONTROL_ENABLED=true
TELEGRAM_POLL_TIMEOUT=25

# ===========================================================================
# MARKETS
# ===========================================================================
# Two markets are supported: XAUUSDs and BTCUSDs - the exact names this
# account's broker uses. Both run M1 SCALPING.
# Their parameters live in src/markets.py, where each value sits next to the
# reasoning for it. Anything below is an OPTIONAL override of that file.
#
# Every override is namespaced with the market symbol, so there is no variable
# that can move both markets at once:
#
#   XAUUSD_THRESHOLD=70          BTCUSD_THRESHOLD=72
#   XAUUSD_ASSUMED_SPREAD_POINTS=20   BTCUSD_ASSUMED_SPREAD_POINTS=1000
#
# Both the suffixed and un-suffixed prefixes work, so XAUUSD_THRESHOLD and
# XAUUSDS_THRESHOLD are the same setting. The shorter one reads better.
#
# Overridable fields (each prefixed with XAUUSD_ or BTCUSD_):
#   BROKER_SYMBOL  THRESHOLD  ASSUMED_SPREAD_POINTS  SLIPPAGE_POINTS_ENTRY
#   SLIPPAGE_POINTS_EXIT  COMMISSION_POINTS_PER_SIDE  MAX_SPREAD_POINTS
#   COOLDOWN_CANDLES  SAME_DIRECTION_COOLDOWN_CANDLES  MAX_SIGNALS_PER_DAY
#   MAX_CONCURRENT_ACTIVE_SIGNALS  MAX_HOLDING_CANDLES  CONTEXT_TIMEFRAME
#
# BROKER_SYMBOL is only needed if you MOVE to a broker that spells an
# instrument differently again. Normally it is unset, because the market names
# above are already this broker's own names - one name per instrument, no
# translation anywhere.
#
# Setting it changes the data feed only, leaving the market's name and its
# stored history alone, so switching broker does not orphan your CSVs:
# XAUUSD_BROKER_SYMBOL=XAUUSD.m
# BTCUSD_BROKER_SYMBOL=BTCUSD.x
#
# Not sure of the exact name? Start the bot anyway. If the configured symbol
# does not exist, it searches your broker's symbol list, uses the obvious match
# for that session, and logs the exact line to paste here.
#
# BTCUSD's shipped values are INITIAL RESEARCH PARAMETERS. They are not
# optimised and are not claimed to be profitable - re-derive them from your own
# venue's data. See src/markets.py and BUILD_REPORT.md.
#
# The unprefixed variables further down are the legacy single-market names.
# They still work, and they apply to XAUUSD ONLY - Bitcoin never inherits them.
# ===========================================================================

# --- Market -----------------------------------------------------------------
# Legacy name for XAUUSD_BROKER_SYMBOL, kept working for existing installs.
#
# CAUTION: if you set this, it OVERRIDES gold's feed name. Leave it commented
# out unless you are upgrading from the single-market build and your broker
# really does name gold something other than XAUUSDs.
# SYMBOL=XAUUSDs

# Which market is selected at start-up when no state file exists yet.
# After that the Telegram panel owns it and the choice is persisted.
DEFAULT_MARKET=XAUUSDs

# Evaluate EVERY market each cycle instead of only the selected one.
# Off by default: the panel selects one market to generate signals, while any
# market with an open paper trade keeps being tracked regardless.
EVALUATE_ALL_MARKETS=false

# The signal timeframe is fixed at M1 and is NOT configurable: this is a
# dedicated micro-scalping build. CONTEXT_TIMEFRAME is the only other timeframe
# fetched - a short-term bias filter. Set it to "" to run on pure M1
# microstructure (the context component is then marked not-applicable and its
# weight is shared out across the others).
CONTEXT_TIMEFRAME=M5

# One pip in price terms - a fallback only. Each market defines its own
# (XAUUSD 0.10, BTCUSD 1.00) in src/markets.py.
PIP_VALUE=0.10

# --- Loop -------------------------------------------------------------------
# M1 closes every 60s, so poll fast enough to catch one promptly.
POLL_SECONDS=5
MAX_CANDLE_STALENESS_SECONDS=180
LOG_LEVEL=INFO

# --- Threshold (read the calibration note in config.py before changing) -----
# XAUUSD's base threshold; the regime still adjusts it per candle.
# Prefer XAUUSD_THRESHOLD / BTCUSD_THRESHOLD - this legacy name is gold-only.
SCALP_THRESHOLD=68
MIN_SCORE_SEPARATION=9
COUNTER_TREND_EXTRA_SCORE=5
MIN_THRESHOLD=40
MAX_THRESHOLD=95

# --- COST MODEL (critical for scalping) -------------------------------------
# At a target of a few pips the spread is not a rounding error - it is often the
# whole trade. Every reward figure is reported twice: RAW and NET of these.
# All values are in POINTS (0.01 of price). 10 points = 1 pip on XAUUSD.
#
# Used when the live spread is unavailable (backtests, or a broker that does not
# report one). 20 points = 2 pips is typical retail; 6-12 is typical raw/ECN.
# XAUUSD ONLY. Bitcoin's assumption is BTCUSD_ASSUMED_SPREAD_POINTS (default
# 1000 points = $10), and it is an ASSUMPTION, not a measurement.
ASSUMED_SPREAD_POINTS=20
SLIPPAGE_POINTS_ENTRY=2
SLIPPAGE_POINTS_EXIT=2
COMMISSION_POINTS_PER_SIDE=0

# TP1 must be worth at least this multiple of the full round-trip cost, and the
# stop must clear this multiple of the spread, or the setup is rejected.
MIN_TP1_COST_MULTIPLE=1.5
MIN_SL_COST_MULTIPLE=2.0

# --- Targets ------------------------------------------------------------------
# Sized from the live M1 ATR, not from fixed pip distances.
# SL_MODE: ATR | STRUCTURE | HYBRID
SL_MODE=HYBRID
SL_ATR_MULTIPLIER=0.70
SL_STRUCTURE_BUFFER_ATR=0.15
# Raw and net reward gates on TP2. The net one is what stops a setup that wins
# on paper and loses after costs.
MIN_TP2_RR=1.2
MIN_NET_TP2_RR=0.30
# A "scalp" needing a bigger move than this is rejected rather than re-scoped.
MAX_TP3_PIPS=12

# --- Holding period -----------------------------------------------------------
# Maximum life of a scalp, in M1 candles (minutes). A signal that has not
# resolved by then is closed at market and recorded as TIMEOUT.
MAX_HOLDING_CANDLES=15
MOVE_SL_TO_BREAKEVEN_AFTER_TP1=true
# Replay raw ticks to decide whether the target or the stop came first when one
# candle traded through both. Without it the pessimistic assumption applies.
USE_TICKS_FOR_AMBIGUOUS_CANDLES=true

# --- Filters ------------------------------------------------------------------
# ALL_SESSIONS, or a comma-separated subset of:
# ASIAN, LONDON, NEW_YORK, LONDON_NEW_YORK_OVERLAP
ALLOWED_SESSIONS=ALL_SESSIONS
MAX_SPREAD_POINTS=35
# Spread relative to the move price can plausibly make within the holding window
# (ATR scaled by the square root of the holding candles).
MAX_SPREAD_TO_EXPECTED_MOVE=0.35
COOLDOWN_CANDLES=10
SAME_DIRECTION_COOLDOWN_CANDLES=20
MAX_SIGNALS_PER_DAY=30
MAX_CONCURRENT_ACTIVE_SIGNALS=3
BLOCK_ON_EXTREME_VOLATILITY=true

# --- Near-signal diagnostic ---------------------------------------------------
# A rejected candidate within this many points BELOW the threshold is logged as
# NEAR_SIGNAL. Never sent as a trading signal; alerts are off by default.
NEAR_SIGNAL_MARGIN=8
NEAR_SIGNAL_ALERTS=false

# ===========================================================================
# DEMO AUTO-EXECUTION  (optional, OFF by default)
# ===========================================================================
# This layer places orders on a DEMO account so the gap between paper
# expectancy and real fills can be measured. It is for TESTING ONLY.
#
# There is NO live-trading mode. EXECUTION_MODE accepts exactly two values,
# and anything else - including LIVE_AUTO - falls back to SIGNAL_ONLY.
#
#   SIGNAL_ONLY   generate, record and notify. No broker interaction. (default)
#   DEMO_AUTO     additionally submit signals to a verified DEMO account.
#
# BOTH of the following must be set, AND dedicated demo credentials must be
# present, before a single order can be sent. Before EVERY order the account
# is re-checked and must report itself as a demo account; a live, contest or
# unverifiable account is refused with no order transmitted.
EXECUTION_MODE=SIGNAL_ONLY
DEMO_TRADING_ENABLED=false

# --- Dedicated demo account -------------------------------------------------
# Deliberately NOT the MT5_* data-feed credentials above. Keeping them separate
# means pointing the data feed at a live account cannot arm execution.
DEMO_MT5_LOGIN=
DEMO_MT5_PASSWORD=
DEMO_MT5_SERVER=

# Stamped on every order this layer creates, so reconciliation after a restart
# can tell our positions from anything else on the account.
DEMO_MAGIC_NUMBER=770101

# --- Position sizing --------------------------------------------------------
# Lot size is NEVER hard-coded: it is derived from the signal's own stop
# distance so a wider stop takes a smaller position, then clamped hard.
# None of these values is a recommendation.
#
# Notional balance used for sizing. Deliberately not read from the broker: a
# demo balance is arbitrary, and letting it drive size makes runs incomparable.
DEMO_ACCOUNT_BALANCE=10000
# Fraction of that balance risked if the stop is hit. 0.005 = 0.5%.
DEMO_RISK_PER_TRADE=0.005
MIN_DEMO_LOT=0.01
MAX_DEMO_LOT=0.10
DEMO_LOT_STEP=0.01

# --- Hard execution safety limits -------------------------------------------
# These are EXECUTION controls, independent of the signal filters that share
# some of their names. A signal can be perfectly valid and still be refused
# execution. Blocking a new trade never stops an open position being managed.
MAX_OPEN_POSITIONS=2
MAX_DEMO_TRADES_PER_DAY=20
# Stop opening new trades once the day is this far down, in account currency.
MAX_DAILY_DEMO_LOSS=200
MAX_ORDER_LOTS=0.10
# Refuse a signal whose stop or target is implausibly far away - a symptom of
# a bad quote rather than a real setup. Fractions of price.
MAX_SL_DISTANCE_PCT=0.02
MAX_TP_DISTANCE_PCT=0.05
# Refuse to enter on a blown-out spread, in points. 0 = use the market's own
# max_spread_points from src/markets.py.
EXECUTION_MAX_SPREAD_POINTS=0
# Maximum deviation from the requested price the broker may fill within.
MAX_SLIPPAGE_POINTS=20

# --- Partial take-profit ladder ---------------------------------------------
# MT5 holds one TP per position, so the broker holds TP3 and this layer closes
# fractions at TP1 and TP2. These are NOT claimed to be optimal - an even-ish
# split is simply the least opinionated starting point. Must sum to 1.0.
TP1_CLOSE_FRACTION=0.33
TP2_CLOSE_FRACTION=0.33
TP3_CLOSE_FRACTION=0.34
