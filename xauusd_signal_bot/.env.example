# ---------------------------------------------------------------------------
# XAUUSD signal engine - copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- MetaTrader 5 (market data only - this system never places orders) ------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if MT5 is not in the default location
MT5_TERMINAL_PATH=

# How many hours the broker's server clock is AHEAD of UTC.
# Most gold brokers run EET: 2 in winter, 3 in summer.  Get this right before
# enabling ALLOWED_SESSIONS - see the "Timezones" section of the README.
MT5_SERVER_UTC_OFFSET_HOURS=0

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather; chat id from @userinfobot (or @RawDataBot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- Market -----------------------------------------------------------------
# Some brokers name the symbol XAUUSD.m, GOLD, XAUUSDx, ... use yours exactly.
SYMBOL=XAUUSD
SIGNAL_TIMEFRAME=M5
INTERMEDIATE_TIMEFRAME=M15
HIGHER_TIMEFRAME=H1
MICRO_TIMEFRAME=M1

# --- Loop -------------------------------------------------------------------
POLL_SECONDS=15
MAX_CANDLE_STALENESS_SECONDS=900
LOG_LEVEL=INFO

# --- Thresholds (see the calibration note in config.py before changing) -----
BASE_THRESHOLD=72
MIN_SCORE_SEPARATION=9
COUNTER_TREND_EXTRA_SCORE=5

# --- Filters ----------------------------------------------------------------
# ALL_SESSIONS, or a comma-separated subset of:
# ASIAN, LONDON, NEW_YORK, LONDON_NEW_YORK_OVERLAP
ALLOWED_SESSIONS=ALL_SESSIONS
MAX_SPREAD_POINTS=40
MAX_SPREAD_ATR_RATIO=0.15
COOLDOWN_CANDLES=10
SAME_DIRECTION_COOLDOWN_CANDLES=20
MAX_SIGNALS_PER_DAY=8
MAX_CONCURRENT_ACTIVE_SIGNALS=2
BLOCK_ON_EXTREME_VOLATILITY=true

# --- Targets ----------------------------------------------------------------
# SL_MODE: ATR | STRUCTURE | HYBRID
SL_MODE=HYBRID
SL_ATR_MULTIPLIER=1.5
SL_STRUCTURE_BUFFER_ATR=0.25
MIN_TP2_RR=1.5

# --- Outcome tracking --------------------------------------------------------
SIGNAL_EXPIRY_CANDLES=96
MOVE_SL_TO_BREAKEVEN_AFTER_TP1=true
