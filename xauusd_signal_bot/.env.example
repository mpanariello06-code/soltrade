# ---------------------------------------------------------------------------
# XAUUSD signal engine - copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- MetaTrader 5 (market data only - this system never places orders) ------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if MT5 is not in the default location
MT5_TERMINAL_PATH=

# How many hours the broker's server clock is AHEAD of UTC.
# Most gold brokers run EET: 2 in winter, 3 in summer.  Get this right before
# enabling ALLOWED_SESSIONS - see the "Timezones" section of the README.
MT5_SERVER_UTC_OFFSET_HOURS=0

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather; chat id from @userinfobot (or @RawDataBot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- Market -----------------------------------------------------------------
# Some brokers name the symbol XAUUSD.m, GOLD, XAUUSDx, ... use yours exactly.
SYMBOL=XAUUSD
# Starting signal timeframe: M1, M5, M15, M30, H1 or H4.
# The confirmation hierarchy follows automatically (see src/timeframes.py):
#   M1 -> M5+M15   M5 -> M15+H1   M15 -> M30+H1
#   M30 -> H1+H4   H1 -> H4       H4 -> none
SIGNAL_TIMEFRAME=M5

# --- Loop -------------------------------------------------------------------
POLL_SECONDS=15
MAX_CANDLE_STALENESS_SECONDS=900
LOG_LEVEL=INFO

# --- Operating mode ----------------------------------------------------------
# RESEARCH     - low threshold, many candidates, collected for paper testing and
#                future ML training.  Messages are labelled and are NOT
#                validated trading signals.
# STANDARD     - the default.
# CONSERVATIVE - demands more confirmation than STANDARD.
# Mode, signal timeframe and thresholds can all be changed from the Telegram
# control panel while running; the last setting is persisted in state.json and
# takes priority over the values here on the next start.
MODE=STANDARD

# --- Thresholds (see the calibration note in config.py before changing) -----
# Per-mode, per-timeframe thresholds live in config.py.  BASE_THRESHOLD is only
# the fallback for a mode/timeframe pair that is missing from that table.
BASE_THRESHOLD=72
MIN_SCORE_SEPARATION=9
COUNTER_TREND_EXTRA_SCORE=5
# Hard limits applied to every threshold, including ones set from Telegram.
MIN_THRESHOLD=40
MAX_THRESHOLD=95

# --- Near-signal diagnostic ---------------------------------------------------
# A rejected candidate whose best score is within NEAR_SIGNAL_MARGIN points
# BELOW the active threshold is logged as NEAR_SIGNAL.  It is never sent as a
# trading signal - it exists to show whether the threshold is slightly strict.
NEAR_SIGNAL_MARGIN=10
NEAR_SIGNAL_ALERTS=false

# --- Telegram control panel ---------------------------------------------------
# Inline-button panel for start/pause/stop, mode, timeframe, threshold,
# analysis, performance and settings.  Send /panel to the bot to summon it.
TELEGRAM_CONTROL_ENABLED=true
TELEGRAM_POLL_TIMEOUT=25

# --- Filters ----------------------------------------------------------------
# ALL_SESSIONS, or a comma-separated subset of:
# ASIAN, LONDON, NEW_YORK, LONDON_NEW_YORK_OVERLAP
ALLOWED_SESSIONS=ALL_SESSIONS
MAX_SPREAD_POINTS=40
MAX_SPREAD_ATR_RATIO=0.15
COOLDOWN_CANDLES=10
SAME_DIRECTION_COOLDOWN_CANDLES=20
MAX_SIGNALS_PER_DAY=8
MAX_CONCURRENT_ACTIVE_SIGNALS=2
BLOCK_ON_EXTREME_VOLATILITY=true

# --- Targets ----------------------------------------------------------------
# SL_MODE: ATR | STRUCTURE | HYBRID
SL_MODE=HYBRID
SL_ATR_MULTIPLIER=1.5
SL_STRUCTURE_BUFFER_ATR=0.25
MIN_TP2_RR=1.5

# --- Outcome tracking --------------------------------------------------------
SIGNAL_EXPIRY_CANDLES=96
MOVE_SL_TO_BREAKEVEN_AFTER_TP1=true
